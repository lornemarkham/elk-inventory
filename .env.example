# Copy this file to .env.local and fill in your Supabase credentials.
# Get these from: Supabase Dashboard → Settings → API
#
# Use the "anon" / "publishable" key — NOT the service_role (secret) key.
# The secret key must never be used in the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI extraction (experimental — api/extract.ts) ─────────────────────────────
# Server-side ONLY. Deliberately NOT prefixed with VITE_ — anything VITE_-
# prefixed gets bundled into the browser JS and would leak this key to
# anyone who opens dev tools. This is read only inside the Vercel Edge
# Function at api/extract.ts, never by the frontend.
#
# For local testing you need `vercel dev` (not `npm run dev`) — plain Vite
# has no idea /api/extract exists. Without it, or without this key set, the
# Capture flow still works end-to-end: it silently falls back to the
# deterministic parser (src/lib/purchaseParser.ts).
#
# Set the real value in Vercel → Project Settings → Environment Variables
# for production, and here (in .env.local, untracked) for `vercel dev`.
OPENAI_API_KEY=sk-...
